        "xlsx_section_index": 0
      }
    },
    {
      "id": "blk_07fdb6d2",
      "type": "text_body",
      "text": "威严而不容质疑的“神祇”，通晓着今州的过去、现在与将来。",
      "annotations": {
        "manual_refs": [],
        "omissions": [],
        "settings": []
      },
      "style": {
        "italic": false,
        "speech_mode": ""
      },
