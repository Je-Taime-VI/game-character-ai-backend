      }
    },
    {
      "id": "blk_d1f83993",
      "type": "text_body",
      "text": "一部根据史实编排的说书戏，讲述了瑝珑今州地区的演变历史。",
      "annotations": {
        "manual_refs": [],
        "omissions": [],
        "settings": []
      },
      "style": {
        "italic": false,
        "speech_mode": ""
      },
      "meta": {
