    {
      "id": "blk_2f17f9a1",
      "type": "text_body",
      "text": "请注意，项目编号“坠剑湖底-阿列夫一”已列入禁入探测区域。",
      "annotations": {
        "manual_refs": [],
        "omissions": [],
