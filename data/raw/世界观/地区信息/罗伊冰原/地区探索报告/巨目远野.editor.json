  "blocks": [
    {
      "id": "blk_f42166c8",
      "type": "text_title",
      "text": "《罗伊神话考》节选",
      "annotations": {
        "manual_refs": [],
        "omissions": [],
        "settings": []
      },
      "style": {
        "italic": false,
        "speech_mode": ""
      },
