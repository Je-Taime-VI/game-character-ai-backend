    },
    {
      "id": "blk_8bb52b39",
      "type": "text_body",
      "text": "发现新的空间站遗迹。根据发现者的报告，该空间站名为天槎空间站。科考站已向天槎空间站派出前期探索队。",
      "annotations": {
        "manual_refs": [],
        "omissions": [],
        "settings": []
      },
      "style": {
        "italic": false,
        "speech_mode": ""
      },
      "meta": {
