      }
    },
    {
      "id": "blk_7536f5a7",
      "type": "text_body",
      "text": "现在，我们所见的这片落日，即是所有日灵的……",
      "annotations": {
        "manual_refs": [],
        "omissions": [],
        "settings": []
      },
      "style": {
