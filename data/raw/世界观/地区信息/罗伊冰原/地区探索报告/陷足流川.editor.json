        "source_row": 16,
        "xlsx_section_index": 0
      }
    },
    {
      "id": "blk_eff0b1fe",
      "type": "text_body",
      "text": "彼时的罗伊人只得栖身于▇▇▇▇的残骸中，在荒芜的冰原上探索满覆冰雪的原野。",
      "annotations": {
