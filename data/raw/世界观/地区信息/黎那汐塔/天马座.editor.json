    {
      "id": "blk_41a10268",
      "type": "text_body",
      "text": "秋季夜空中最耀眼的星象，而关于星象，存在着许多传说。",
      "annotations": {
        "manual_refs": [],
        "omissions": [],
        "settings": []
      },
      "style": {
