    },
    {
      "id": "blk_86a562d2",
      "type": "text_body",
      "text": "爱弥斯参加星炬学院社团饮品创新大赛的获奖之作，据本人称是表达了作者的思乡之情。",
      "annotations": {
        "manual_refs": [],
        "omissions": [],
        "settings": []
